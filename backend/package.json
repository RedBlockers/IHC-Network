{
    "name": "qweillo-backend",
    "version": "2.0.0",
    "private": true,
    "description": "API temps réel de qweillo — Express, MySQL, Socket.IO",
    "main": "src/server.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon --watch src src/server.js",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage --runInBand",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "migrate": "node src/db/migrate.js up",
        "migrate:status": "node src/db/migrate.js status"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1058.0",
        "@simplewebauthn/server": "^13.3.2",
        "@socket.io/redis-adapter": "^8.3.0",
        "argon2": "0.45.1",
        "bcrypt": "^6.0.0",
        "cookie": "1.0.2",
        "cors": "^2.8.6",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.2.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "livekit-server-sdk": "2.17.0",
        "multer": "^2.1.1",
        "mysql2": "^3.11.3",
        "nodemailer": "^10.0.0",
        "prom-client": "^15.1.3",
        "rate-limit-redis": "^4.2.0",
        "sharp": "^0.35.3",
        "socket.io": "^4.8.0",
        "web-push": "^3.6.7",
        "winston": "^3.16.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "jest": "^30.4.2",
        "nodemon": "^3.1.10",
        "supertest": "^7.2.2"
    },
    "overrides": {
        "qs": "6.16.0"
    }
}
