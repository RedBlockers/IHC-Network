NODE_ENV=development
PORT=3000
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qweillo
DB_PASSWORD=
DB_DATABASE=qweillo
DB_CONNECTION_LIMIT=10


REDIS_URL=


S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=qweillo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://127.0.0.1:9000/qweillo
LOCAL_STORAGE_DIR=
STORAGE_PUBLIC_URL=/media
MAX_ATTACHMENT_BYTES=2147483648
# Utiliser un disque avec assez de place, pas un tmpfs limité à quelques Mio.
UPLOAD_TMP_DIR=/tmp/qweillo-uploads

LIVEKIT_URL=wss://media.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
LIVEKIT_TURN_HOST=
LIVEKIT_TURN_PORT=3478

LOG_LEVEL=info
LOG_FORMAT=pretty
SLOW_QUERY_MS=200


SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=qweillo <no-reply@example.org>
