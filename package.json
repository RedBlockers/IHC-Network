{
  "name": "nodejs",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test npm run db:seed && cross-env NODE_ENV=test node -r dotenv/config server.js dotenv_config_path=.env.test",
    "test:conserve": "cross-env NODE_ENV=test npm run db:seed:conserve && cross-env NODE_ENV=test node -r dotenv/config server.js dotenv_config_path=.env.test",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:seed": "node -r dotenv/config scripts/seed.js dotenv_config_path=.env.test",
    "db:seed:conserve": "node -r dotenv/config scripts/seed.js dotenv_config_path=.env.test --conserve-database"
  },
