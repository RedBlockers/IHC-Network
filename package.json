    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "nodemon": "^3.1.10",
    "react-icons": "^5.5.0",
    "socket.io": "^4.8.0",
    "winston": "^3.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "http-server": "^14.1.1"
  }
