{
  "version": "1.0.0",
  "surfaces": {
    "--bg-base": "#0b0e13",
    "--bg-raised": "#12161d",
    "--bg-surface": "#151a21",
    "--bg-overlay": "#1b212b",
    "--bg-sunken": "#0e1116"
  },
  "text": {
    "--text-primary": "#edf1f6",
    "--text-secondary": "#a8b3c1",
    "--text-muted": "#8895a5",
    "--text-faint": "#6b7788"
  },
  "accent": {
    "--accent-bg": "#12b5a2",
    "--accent-text": "#2dd4bf",
    "--on-accent": "#06251f",
    "--focus-ring": "#5eead4"
  },
  "semantic": {
    "--success": "#3dc97c",
    "--warning": "#e8b93e",
    "--danger": "#e5544b",
    "--info": "#22b8cf"
  },
  "presence": {
    "--presence-online": "#3dc97c",
    "--presence-idle": "#e8b93e",
    "--presence-dnd": "#e5544b",
    "--presence-offline": "#6b7788",
    "--presence-stream": "#8b5cf6"
  },
  "space": {
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "24px",
    "--space-6": "32px",
    "--space-7": "48px",
    "--space-8": "64px"
  },
  "radius": {
    "--r-sm": "4px",
    "--r-md": "8px",
    "--r-lg": "12px",
    "--r-xl": "16px",
    "--r-full": "999px",
    "$note": "Modulables de ±4 px par le thème communautaire via --com-radius-delta."
  },
  "elevation": {
    "--elev-0": "none",
    "--elev-1": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "--elev-2": "0 4px 12px rgba(0, 0, 0, 0.45)",
    "--elev-3": "0 12px 32px rgba(0, 0, 0, 0.55)",
    "--elev-4": "0 16px 48px rgba(0, 0, 0, 0.6)"
  },
  "motion": {
    "--dur-micro": "120ms",
    "--dur-panel": "200ms",
    "--dur-view": "260ms",
    "--dur-expressive": "400ms",
    "--ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "--ease-exit": "cubic-bezier(0.4, 0, 1, 1)",
    "$note": "« Réduire les animations » ramène toutes les durées à des fondus ≤ 80 ms."
  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "weights": [
        500,
        600,
        700
      ],
      "usage": "titres d'écrans, bannières, chiffres clés"
    },
    "ui": {
      "family": "Onest",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "usage": "interface et messages"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        500
      ],
      "usage": "code, identifiants, tokens"
    }
  },
  "icons": {
    "--icon-meta": "16px",
    "--icon-default": "20px",
    "--icon-nav": "24px",
    "--icon-stroke": "1.8"
  },
  "focus": {
    "--focus-ring-width": "2px",
    "--focus-ring-offset": "2px"
  },
  "touch": {
    "--touch-min": "44px"
  },
  "density": {
    "comfortable": {
      "--density-avatar": "40px",
      "--density-text": "0.9375rem",
      "--density-leading": "1.5",
      "--density-pad-y": "12px",
      "--density-pad-x": "14px",
      "--density-gap": "12px"
    },
    "compact": {
      "--density-avatar": "28px",
      "--density-text": "0.875rem",
      "--density-leading": "1.4",
      "--density-pad-y": "7px",
      "--density-pad-x": "12px",
      "--density-gap": "10px"
    }
  },
  "community": {
    "$note": "24 paramètres encadrés, validés serveur avec contrôle AA bloquant.",
    "tokens": [
      "--com-accent",
      "--com-accent-2",
      "--com-surface-tint",
      "--com-radius-delta"
    ],
    "neverConfigurable": [
      "tailles et contrastes de texte",
      "zones tactiles",
      "focus",
      "structure de navigation",
      "couleurs sémantiques",
      "états de présence"
    ]
  },
  "breakpoints": {
    "mobile": [
      360,
      767
    ],
    "tablet": [
      768,
      1279
    ],
    "desktop": [
      1280,
      1919
    ],
    "large": [
      1920,
      2559
    ],
    "ultrawide": [
      2560,
      null
    ],
    "$note": "Au-delà de 2560 px, la colonne de lecture est plafonnée à 960 px."
  },
  "themes": [
    "dark",
    "light",
    "oled",
    "contrast"
  ]
}
